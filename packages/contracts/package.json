{
  "name": "@petroglyph/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/endpoint.d.ts",
      "default": "./dist/endpoint.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "default": "./dist/operations/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "lint": "eslint .",
    "prebuild": "pnpm generate-openapi",
    "pretest": "pnpm generate-openapi",
    "pretypecheck": "pnpm generate-openapi",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "hono": "^4.12.10"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "hono": "^4.12.10",
    "tsx": "^4.21.0"
  }
}

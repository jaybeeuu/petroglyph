{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "changeType": {
      "type": "string",
      "const": "deleted"
    },
    "itemId": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "s3Key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["profileId", "source", "changeType", "itemId", "relativePath", "s3Key"],
  "additionalProperties": false,
  "$id": "https://schemas.petroglyph.dev/file-deleted/v1.json"
}

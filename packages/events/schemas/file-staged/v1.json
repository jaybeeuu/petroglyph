{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "changeType": {
      "type": "string",
      "enum": ["created", "updated"]
    },
    "itemId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "s3Key": {
      "type": "string",
      "minLength": 1
    },
    "mimeType": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "profileId",
    "source",
    "changeType",
    "itemId",
    "name",
    "relativePath",
    "s3Key",
    "mimeType"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.petroglyph.dev/file-staged/v1.json"
}
